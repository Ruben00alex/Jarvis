# Generate actual secrets on the VPS. Do not commit the resulting .env.
# POSTGRES_PASSWORD must be hex, avoiding URL encoding in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace_with_openssl_rand_hex_32
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.831.1
POSTGRES_IMAGE=postgres:17-alpine
